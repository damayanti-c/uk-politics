"],"metadata":{"id":"Sm1mLFn8TfN6"}},{"cell_type":"code","source":["# helper functions to allow uploading a .zip shapefile\n","\n","# pip install geopandas shapely pyproj rtree pandas\n","import tempfile, zipfile, shutil, hashlib, os\n","from pathlib import Path\n","from io import BytesIO\n","import geopandas as gpd\n","\n","def _write_bytes_to_tmp(raw: bytes, suffix: str) -> Path:\n","    tmpdir = Path(tempfile.mkdtemp(prefix=\"vec_up_\"))\n","    fpath = tmpdir / f\"upload{suffix}\"\n","    with open(fpath, \"wb\") as f:\n","        f.write(raw)\n","    return fpath\n","\n","def _sha256_16(raw: bytes) -> str:\n","    return hashlib.sha256(raw).hexdigest()[:16]\n","\n","class ZippedVectorLoader:\n","    \"\"\"\n","    - If given a .zip: extract, find a vector layer (.shp/.gpkg/.geojson), load to GeoDataFrame.\n","    - If given a .gpkg or .geojson: load directly.\n","    - Optional persistent cache for uploaded zips (and their extracted folders).\n","    - Keeps temp files until .cleanup() is called (important for Shapefile sidecars).\n","    \"\"\"\n","    def __init__(\n","        self,\n","        prefer_exts=(\".shp\", \".gpkg\", \".geojson\"),\n","        use_cache: bool = True,\n","        cache_dir: str | os.PathLike = Path.home() / \".vector_cache\",\n","    ):\n","        self.prefer_exts = tuple(e.lower() for e in prefer_exts)\n","        self.use_cache = use_cache\n","        self.cache_dir = Path(cache_dir)\n","        self.cache_dir.mkdir(parents=True, exist_ok=True)\n","        self._tmpdirs = []   # track temp dirs for cleanup\n","        self.layer_path = None\n","        self.gdf = None\n","\n","    def _extract_zip(self, zip_path: Path, dest_dir: Path | None = None) -> Path:\n","        \"\"\"\n","        Extract zip to dest_dir (if provided) or to a fresh temp dir.\n","        Returns the directory containing extracted files.\n","        \"\"\"\n","        if dest_dir:\n","            dest_dir.mkdir(parents=True, exist_ok=True)\n","            # Avoid re-extracting if it looks already extracted\n","            if not any(dest_dir.iterdir()):\n","                with zipfile.ZipFile(zip_path) as zf:\n","                    zf.extractall(dest_dir)\n","            return dest_dir\n","        # temp extraction\n","        tmpdir = Path(tempfile.mkdtemp(prefix=\"vec_zip_\"))\n","        with zipfile.ZipFile(zip_path) as zf:\n","            zf.extractall(tmpdir)\n","        self._tmpdirs.append(tmpdir)\n","        return tmpdir\n","\n","    def _pick_layer_path(self, root: Path, layer_hint: str | None):\n","        # Search in priority order of extensions\n","        candidates = []\n","        for ext in self.prefer_exts:\n","            candidates.extend(sorted(root.rglob(f\"*{ext}\")))\n","        if not candidates:\n","            raise FileNotFoundError(\n","                f\"No supported vector layer found under {root}. \"\n","                f\"Expected one of: {', '.join(self.prefer_exts)}\"\n","            )\n","        if layer_hint:\n","            layer_hint = layer_hint.lower()\n","            hinted = [p for p in candidates if layer_hint in p.name.lower()]\n","            if hinted:\n","                return hinted[0]\n","        # Heuristic: shortest filename (often the primary layer)\n","        return min(candidates, key=lambda p: len(p.name))\n","\n","    def load_from_path(self, path: str | Path, layer_hint: str | None = None):\n","        \"\"\"\n","        Load from a local path. If it's a .zip and caching is enabled, we also\n","        keep a cached extraction copy (by file hash) to speed future loads.\n","        \"\"\"\n","        path = Path(path)\n","        if not path.exists():\n","            raise FileNotFoundError(f\"File not found: {path}\")\n","\n","        if path.suffix.lower() == \".zip\":\n","            # If caching, compute hash and use a cached extraction dir\n","            if self.use_cache:\n","                raw = path.read_bytes()\n","                digest = _sha256_16(raw)\n","                cached_zip = self.cache_dir / f\"{digest}_{path.name}\"\n","                if not cached_zip.exists():\n","                    cached_zip.write_bytes(raw)\n","                cached_extract_dir = self.cache_dir / f\"{digest}_extract\"\n","                root = self._extract_zip(cached_zip, dest_dir=cached_extract_dir)\n","                self.layer_path = self._pick_layer_path(root, layer_hint)\n","                self.gdf = gpd.read_file(self.layer_path)\n","            else:\n","                root = self._extract_zip(path)\n","                self.layer_path = self._pick_layer_path(root, layer_hint)\n","                self.gdf = gpd.read_file(self.layer_path)\n","\n","        elif path.suffix.lower() in (\".gpkg\", \".geojson\"):\n","            self.layer_path = path\n","            self.gdf = gpd.read_file(path)\n","        else:\n","            raise ValueError(\"Please provide a .zip (of a Shapefile), .gpkg, or .geojson.\")\n","\n","        return self.gdf\n","\n","    def load_from_bytes(self, name: str, raw: bytes, layer_hint: str | None = None):\n","        \"\"\"\n","        Load from an uploaded file (name+raw). If it's a .zip and caching is enabled,\n","        we persist the zip and extracted folder under cache_dir keyed by content hash.\n","        \"\"\"\n","        suffix = Path(name).suffix.lower()\n","\n","        if suffix == \".zip\":\n","            if self.use_cache:\n","                digest = _sha256_16(raw)\n","                cached_zip = self.cache_dir / f\"{digest}_{Path(name).name}\"\n","                if not cached_zip.exists():\n","                    cached_zip.write_bytes(raw)\n","                cached_extract_dir = self.cache_dir / f\"{digest}_extract\"\n","                root = self._extract_zip(cached_zip, dest_dir=cached_extract_dir)\n","                self.layer_path = self._pick_layer_path(root, layer_hint)\n","                self.gdf = gpd.read_file(self.layer_path)\n","            else:\n","                zip_path = _write_bytes_to_tmp(raw, \".zip\")\n","                self._tmpdirs.append(zip_path.parent)\n","                root = self._extract_zip(zip_path)\n","                self.layer_path = self._pick_layer_path(root, layer_hint)\n","                self.gdf = gpd.read_file(self.layer_path)\n","\n","        elif suffix in (\".gpkg\", \".geojson\"):\n","            if self.use_cache:\n","                digest = _sha256_16(raw)\n","                cached_path = self.cache_dir / f\"{digest}_{Path(name).name}\"\n","                if not cached_path.exists():\n","                    cached_path.write_bytes(raw)\n","                self.layer_path = cached_path\n","            else:\n","                vec_path = _write_bytes_to_tmp(raw, suffix)\n","                self._tmpdirs.append(vec_path.parent)\n","                self.layer_path = vec_path\n","            self.gdf = gpd.read_file(self.layer_path)\n","        else:\n","            raise ValueError(\"Upload a .zip (Shapefile), .gpkg, or .geojson.\")\n","        return self.gdf\n","\n","    def cleanup(self):\n","        \"\"\"\n","        Removes only temporary dirs created during this session.\n","        Cached files/folders under cache_dir are preserved.\n","        \"\"\"\n","        for td in self._tmpdirs:\n","            try:\n","                shutil.rmtree(td, ignore_errors=True)\n","            except Exception:\n","                pass\n","        self._tmpdirs = []\n","\n","\n","def upload_vector_layer(path: str | None = None, layer_hint: str | None = None, *, use_cache: bool = True, cache_dir: str | os.PathLike = Path.home() / \".vector_cache\"):\n","    \"\"\"\n","    If 'path' is provided, load from local path.\n","    If 'path' is None or '', pop a Colab upload dialog and load the first supported file.\n","    Returns: (gdf, loader) where loader.cleanup() will delete temp files (cache is preserved).\n","    \"\"\"\n","    loader = ZippedVectorLoader(use_cache=use_cache, cache_dir=cache_dir)\n","    if path:\n","        gdf = loader.load_from_path(path, layer_hint=layer_hint)\n","        return gdf, loader\n","\n","    # Colab upload path\n","    try:\n","        from google.colab import files  # type: ignore\n","    except Exception as e:\n","        raise RuntimeError(\n","            \"No path provided and google.colab not available. \"\n","            \"Provide a local path, or run this in Google Colab.\"\n","        ) from e\n","\n","    uploaded = files.upload()  # opens browser dialog\n","    if not uploaded:\n","        raise RuntimeError(\"No file selected.\")\n","    name, raw = next(iter(uploaded.items()))\n","    gdf = loader.load_from_bytes(name, raw, layer_hint=layer_hint)\n","    return gdf, loader"],"metadata":{"id":"rZ8Eq3dUS7zR"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# run to upload a shapefile and convert co-ordinates to standard geography\n","\n","import pandas as pd, geopandas as gpd\n","from shapely.geometry import Point\n","\n","# 1) Your points\n","# df = pd.DataFrame({\n","#     \"query\": [\"Manchester Town Hall\",\"Cardiff Castle\",\"Eden Project\", \"Royal Sutton Coldfield Town Council\"],\n","#     \"lat\":   [53.479327, 51.482231, 50.360134, 52.567197],\n","#     \"lng\":   [-2.243730, -3.181177, -4.744718, -1.824758],\n","#     \"name\":  [\"Manchester City Council\",\"Cardiff Castle\",\"Eden Project\", \"Royal Town of Sutton Coldfield Town Council\"]\n","# })\n","\n","points = gpd.GeoDataFrame(\n","    df, geometry=[Point(xy) for xy in zip(df[\"lng\"], df[\"lat\"])], crs=\"EPSG:4326\"\n",")\n","\n","# 2) Load LADs via path OR pop-up:\n","#    a) From a local file:\n","# lad, loader = upload_vector_layer(\"Local_Authority_Districts_May_2024_Boundaries_UK_BFE.zip\", layer_hint=\"LAD\")\n","\n","#    b) From a Colab upload dialog (leave path blank):\n","lad, loader = upload_vector_layer(layer_hint=\"LAD\")\n","\n","# 3) Reproject & join\n","if lad.crs and points.crs != l